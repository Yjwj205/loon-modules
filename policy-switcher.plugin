#!name=定时切换策略
#!desc=按时间表自动把指定策略组切换到指定节点（$config.setSelectPolicy），幂等、可高频轮询
#!author=Minis
#!icon=arrow.triangle.swap
#!system=ios

[Argument]
group = input,"综合利用EMBY4837",tag=策略组名称,desc=必须与 Loon 中的策略组名完全一致
schedule = input,"09:00=Matrix;19:00=吹雪云观影组",tag=时间表,desc=格式 HH:mm=子策略名，多条用英文分号(;)分隔
cronExpr = input,"0 */5 * * * *",tag=检查频率,desc=6 段 cron（秒 分 时 日 月 周），默认每 5 分钟检查
notify = switch,true,tag=切换时通知

[Script]
cron ${cronExpr} then script("https://raw.githubusercontent.com/Yjwj205/loon-modules/main/policy-switcher.js", {${group}, ${schedule}, ${notify}}) with tag="定时切换策略", timeout=30
