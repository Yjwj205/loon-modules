#!name=打开 TG 时打断连接
#!desc=无定时。由「快捷指令 → 自动化 → App 已打开(Telegram)」请求 http://kill.loon/kill 触发
#!author=Minis
#!icon=bolt.horizontal.circle.fill
#!system=ios

[Script]
# 捷径请求这个地址即触发：http://kill.loon/kill?kill=1&repeat=1&gap=400&notify=0
# 纯 http，不需要 MITM；参数全部可省，默认值见下
request if ${url} ~= /^http:\/\/kill\.loon\//i then script("https://raw.githubusercontent.com/Yjwj205/loon-modules/main/kill-switch.js", "kill=1&repeat=1&gap=400&notify=0") with tag="打开 TG · 打断连接", timeout=20
