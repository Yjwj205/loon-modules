#!name = 定时切换策略·准点
#!desc = 自由更换策略节点及时间
#!author = Yjwj205 / Minis
#!homepage = https://github.com/Yjwj205
#!icon = clock.badge.checkmark
#!system = iOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-14
#!tag = 策略
#!type = normal

[Argument]
group = input,"综合利用EMBY4837",tag=策略组名称,desc=必须与 Loon 中的策略组名完全一致
amTime = input,"0 9 * * *",tag=早上触发时间,desc=5 段 cron：分 时 日 月 周。0 9 * * * = 每天 09:00
amTarget = input,"Matrix",tag=早上切换为,desc=早上的目标节点或子策略，填名称
pmTime = input,"0 19 * * *",tag=晚上触发时间,desc=5 段 cron：分 时 日 月 周。0 19 * * * = 每天 19:00
pmTarget = input,"吹雪云观影组",tag=晚上切换为,desc=晚上的目标节点或子策略，填名称
notify = switch,true,tag=切换时通知

[Script]
cron ${amTime} then script("https://raw.githubusercontent.com/Yjwj205/loon-modules/main/switch-exact.js", {${group}, ${amTarget}, ${notify}}) with tag="准点切换·早", timeout=30
cron ${pmTime} then script("https://raw.githubusercontent.com/Yjwj205/loon-modules/main/switch-exact.js", {${group}, ${pmTarget}, ${notify}}) with tag="准点切换·晚", timeout=30
