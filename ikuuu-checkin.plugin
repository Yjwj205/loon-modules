#!name = iKuuu 每日签到
#!desc = 自动签到 ikuuu.org：可开关的 Cookie 自动抓取、每日定时 + 手动签到，通知签到结果和剩余流量（可选的「先读流量再签到」会用「页面读数 + 赠送」补算）、Cookie 即将过期提醒
#!author = Yjwj205 / Minis
#!homepage = https://github.com/Yjwj205
#!icon = calendar.badge.checkmark
#!system = iOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-25
#!tag = 签到
#!type = normal

[Argument]
cookie = input,"",tag=Cookie,desc=可选。留空则使用自动抓取/已保存的 Cookie
capture = switch,true,tag=抓取 Cookie,desc=开启后打开 ikuuu.org 自动保存登录 Cookie，拿到后可关闭；关闭不影响已保存的 Cookie
requestNode = input,"",tag=请求节点,desc=可选：节点名 / 策略组名 / DIRECT，留空跟随规则；偶发证书错误时固定到常用节点
cronExpr = input,"0 8 * * *",tag=签到时间,desc=5 段 cron（分 时 日 月 周），默认每天 08:00
enabled = switch,true,tag=定时签到
notify = switch,true,tag=签到通知
expireInfo = switch,true,tag=CK 剩余天数,desc=开启后签到通知里显示 CK 还剩几天；关闭后只保留「剩余 ≤2 天」的快过期提醒
parallel = switch,false,tag=先读流量再签到,desc=打开后先把流量页读完再发签到，页面一定早于签到落库；剩余流量 = 页面读数 + 今日签到赠送（≈）。关掉则签到后再读，数字就是官网口径

[Script]
request if ${url} ~= /^https?:\/\/(?:www\.)?ikuuu\.org\//i then script("https://raw.githubusercontent.com/Yjwj205/loon-modules/main/ikuuu-cookie.js", {${notify}}) with enable=${capture}, tag="iKuuu Cookie 抓取"

generic then script("https://raw.githubusercontent.com/Yjwj205/loon-modules/main/ikuuu-checkin.js", {${cookie}, ${notify}, ${requestNode}, ${expireInfo}, ${parallel}}) with tag="iKuuu 签到（手动）", timeout=60, img_url="calendar.badge.checkmark"

cron ${cronExpr} then script("https://raw.githubusercontent.com/Yjwj205/loon-modules/main/ikuuu-checkin.js", {${cookie}, ${notify}, ${requestNode}, ${expireInfo}, ${parallel}}) with enable=${enabled}, tag="iKuuu 定时签到", timeout=60

[Mitm]
hostname = ikuuu.org,*.ikuuu.org
