#!name = 带宽测速
#!desc = 测速源与 Surge 内置测速一致（Cloudflare）。从节点入口运行就测该节点，在脚本页运行则不走代理测本地带宽。大流量会按 95MB 分块续传，可测 300MB 以上；只测不切换。
#!author = Minis
#!system = iOS,iPadOS,macOS
#!loon_version = 3.5.1(983)
#!date = 2026-11-13
#!tag = 工具,网络
#!type = normal

[Argument]
target = select,"自动","本地直连","当前节点","指定节点",type=string,tag=测速对象,desc=自动=从节点入口进来或填了节点名就测节点，否则测本地带宽
policyGroup = input,"",type=string,tag=策略组,desc=测节点时使用；留空自动查找
nodeName = input,"",type=string,tag=节点名,desc=指定节点时使用；留空则用入口节点或当前选中
sizeMB = input,300,type=number,tag=下载大小(MB),desc=建议 300 以上测准高带宽；Cloudflare 会按 95MB 分块续传
testURL = input,"",type=string,tag=测速地址,desc=留空用 Cloudflare（与 Surge 同源）；支持 {bytes} 占位符
fallbackURL = input,"",type=string,tag=备用测速地址,desc=主源 429/403 时自动改用；留空自动选
latencyURL = input,"",type=string,tag=延迟测试地址,desc=留空用 Cloudflare 0 字节（与测速同源）
latencySamples = input,2,type=number,tag=延迟采样次数,desc=0 表示不测延迟
threads = input,1,type=number,tag=并发连接数,desc=1=单线程（测单连接速度）；2-8 测多连接总带宽
timeout = input,240,type=number,tag=超时(秒),desc=下载单块的最长等待，低于 90 秒按 90 秒算
notify = switch,true,type=boolean,tag=发送通知,desc=关闭后只在 Loon 脚本日志里输出结果
enabled = switch,true,type=boolean,tag=启用

[Script]
generic then script("https://raw.githubusercontent.com/Yjwj205/loon-modules/main/speedtest/speedtest.js", {${target}, ${policyGroup}, ${nodeName}, ${sizeMB}, ${testURL}, ${fallbackURL}, ${latencyURL}, ${latencySamples}, ${threads}, ${timeout}, ${notify}, ${enabled}}) with enable=${enabled}, tag="带宽测速", img_url="speedometer", timeout=600
